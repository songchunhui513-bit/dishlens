# ── Supabase ──────────────────────────────────────
# Required. Get from https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Prefer the new Supabase Secret key (sb_secret_...) when available.
# Legacy service_role also works during Supabase's migration period.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# For auth (Phase 1.3). Copy the corresponding public values above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── AI Providers (至少配一个) ─────────────────────

# Qwen / Alibaba Bailian (推荐首选)
# https://bailian.console.aliyun.com/
QWEN_API_KEY=
# Fast menu OCR: Flash gives the first usable page quickly; Plus is the quality fallback.
QWEN_FAST_VL_MODEL=qwen3-vl-flash
QWEN_VL_MODEL=qwen3-vl-plus
QWEN_FAST_FIRST_PASS_MODELS=qwen3-vl-flash,qwen3-vl-plus
MENU_FAST_FIRST_PASS_ATTEMPT_TIMEOUT_MS=20000
MENU_FAST_FIRST_PASS_OCR_CONCURRENCY=4
MENU_IMAGE_GENERATION_CONCURRENCY=1
MENU_IMAGE_GENERATION_REQUEST_INTERVAL_MS=1500
MENU_IMAGE_GENERATION_POLL_TIMEOUT_MS=120000
MENU_TASK_STORE_WRITE_TIMEOUT_MS=200

# Google Gemini (备选)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ollama (本地开发/自部署)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_VISION_MODEL=minicpm-v:8b
# OLLAMA_TEXT_MODEL=qwen2.5:32b

# ── Image Generation (Phase 3.2) ──────────────────
# Overseas production: Singapore Model Studio synchronous image API.
# The workspace, endpoint, and API key must all belong to Singapore.
IMAGE_PROVIDER=wan
ALIBABA_MODEL_STUDIO_WORKSPACE_ID=
ALIBABA_MODEL_STUDIO_API_KEY=
# Optional explicit override. Normally derived from WORKSPACE_ID above.
# ALIBABA_MODEL_STUDIO_BASE_URL=https://WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/api/v1
ALIBABA_IMAGE_FAST_MODEL=z-image-turbo
ALIBABA_IMAGE_FALLBACK_MODEL=wan2.7-image
# Accuracy-first categories skip the fast model unless the quality model fails.
ALIBABA_IMAGE_QUALITY_KINDS=drink,soup,seafood,meal
ALIBABA_IMAGE_REQUEST_INTERVAL_MS=550
ALIBABA_IMAGE_FAST_TIMEOUT_MS=15000
ALIBABA_IMAGE_QUALITY_TIMEOUT_MS=45000
# Use wan-legacy only during rollback to the old wanx2.1 async protocol.
# IMAGE_PROVIDER=wan-legacy
# Free development fallback; not recommended for production.
# IMAGE_PROVIDER=pollinations

# ── Upstash Redis (Phase 1.4, 任务队列) ───────────
# https://console.upstash.com/redis
# UPSTASH_REDIS_URL=
# UPSTASH_REDIS_TOKEN=

# ── Cloudflare R2 (图片存储) ──────────────────────
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# ── Alibaba Cloud OSS (production image primary store) ──
# Keep ECS, OSS, RDS, and Model Studio in Singapore for overseas traffic.
ALIYUN_OSS_REGION=oss-ap-southeast-1
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
# Prefer a custom CDN domain, for example https://images.example.com.
ALIYUN_OSS_PUBLIC_BASE_URL=
# Same hostname only, exposed to the browser for persisted-image validation.
NEXT_PUBLIC_DISH_IMAGE_CDN_HOST=
