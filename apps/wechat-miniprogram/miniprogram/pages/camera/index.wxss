.capture-panel {
  margin-top: 36rpx;
  padding: 44rpx 34rpx;
  text-align: center;
}

.camera-illustration {
  position: relative;
  width: 210rpx;
  height: 170rpx;
  margin: 0 auto;
}

.camera-body {
  position: absolute;
  left: 22rpx;
  top: 46rpx;
  width: 166rpx;
  height: 100rpx;
  border: 8rpx solid #d9a56c;
  border-radius: 32rpx;
  background: #fff8e9;
}

.camera-lens {
  position: absolute;
  left: 78rpx;
  top: 70rpx;
  width: 54rpx;
  height: 54rpx;
  border: 8rpx solid #43b85a;
  border-radius: 50%;
  background: #e8f7df;
}

.camera-spark {
  position: absolute;
  border-radius: 50%;
  background: #ffae32;
}

.spark-a {
  left: 28rpx;
  top: 22rpx;
  width: 16rpx;
  height: 16rpx;
}

.spark-b {
  right: 20rpx;
  top: 18rpx;
  width: 12rpx;
  height: 12rpx;
}

.capture-title {
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.capture-desc {
  margin-top: 8rpx;
  color: #827b72;
  font-size: 25rpx;
}

.capture-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 30rpx;
}

.preview-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 26rpx;
  padding: 20rpx;
}

.preview-image {
  width: 128rpx;
  height: 128rpx;
  border-radius: 28rpx;
  background: #f2dfc7;
}

.preview-title {
  font-size: 28rpx;
  font-weight: 900;
}

.preview-desc {
  margin-top: 8rpx;
  color: #827b72;
  font-size: 24rpx;
}

.start-button {
  margin-top: 34rpx;
}
