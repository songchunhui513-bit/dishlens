.summary-card {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 34rpx;
}

.summary-title {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 900;
}

.summary-subtitle {
  margin-top: 10rpx;
  color: #80776d;
  font-size: 25rpx;
}

.share-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.share-button {
  min-height: 94rpx;
  font-size: 28rpx;
}

button.share-button {
  border: 0;
}

.full-share {
  margin-top: 18rpx;
}

.dish-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 28rpx;
}

.dish-card {
  display: flex;
  gap: 22rpx;
  padding: 28rpx;
}

.dish-index {
  color: #32a950;
  font-size: 26rpx;
  font-weight: 900;
}

.dish-main {
  min-width: 0;
  flex: 1;
}

.dish-desc {
  margin-top: 14rpx;
  color: #5f584f;
  font-size: 25rpx;
  line-height: 1.52;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.small-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #e7f5dc;
  color: #34a64f;
  font-size: 22rpx;
  font-weight: 800;
}
